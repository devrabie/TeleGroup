#: src/admin_handlers.py:35
msgid ""
"<b>Usage:</b> <code>/create_plan &lt;name&gt; &lt;price&gt; &lt;days&gt; "
"&lt;accounts&gt; &lt;limit&gt;</code>\n"
"\n"
"<b>Example:</b> <code>/create_plan Basic 100 30 2 10</code>"
msgstr ""
"<b>الاستخدام:</b> <code>/create_plan &lt;الاسم&gt; &lt;السعر&gt; "
"&lt;الأيام&gt; &lt;الحسابات&gt; &lt;الحد&gt;</code>\n"
"\n"
"<b>مثال:</b> <code>/create_plan أساسية 100 30 2 10</code>"

