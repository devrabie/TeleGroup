# --- Telegram Bot Configuration ---
# Get this from @BotFather on Telegram.
BOT_TOKEN=""

# --- Pyrogram Client Configuration ---
# Get these from my.telegram.org.
API_ID=""
API_HASH=""

# --- Bot Administration ---
# Your numeric Telegram User ID. You can get this from @userinfobot.
# For multiple admins, separate with a comma (e.g., 12345,67890)
ADMIN_IDS=""

# --- Database ---
# Async SQLAlchemy URL. Docker Compose overrides this to the postgres service.
DATABASE_URL="postgresql+asyncpg://telegroup:telegroup@localhost:5432/telegroup"

# Fernet key for managed-account session strings. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=""

# --- Payment Provider ---
# Optional. Telegram Stars invoices do not use a provider token.
PAYMENT_PROVIDER_TOKEN=""

# The token for the @CryptoBot API, from the bot itself.
# Go to @CryptoBot -> Crypto Pay -> Create App to get one.
CRYPTO_PAY_API_TOKEN=""
# The base URL for the Crypto Pay API. Defaults to mainnet.
# For testing, use "https://testnet-pay.crypt.bot/api/"
CRYPTO_PAY_API_BASE_URL="https://pay.crypt.bot/api/"

# --- Optional: Redis cache ---
# Used to cache account profiles, private chat lists, and recent messages.
# Leave empty to use a short-lived in-memory cache instead.
# REDIS_URL="redis://127.0.0.1:6379/0"

# --- Optional: Proxy URL ---
# Leave empty to skip automatic proxy download.
# Do not commit a URL that contains an API token.
# WEBSHARE_PROXY_API_URL=""
# Fallback credentials used only when a proxy string has no username/password.
# PROXY_USERNAME=""
# PROXY_PASSWORD=""

# --- Optional: Webhook Configuration ---
# Set WEBHOOK_ENABLED to "true" to run the bot in webhook mode.
# This is REQUIRED for Crypto Pay notifications to work.
WEBHOOK_ENABLED="false"
# The full public URL of your bot's webhook (e.g., https://your.domain.com)
WEBHOOK_URL=""
# A random secret string passed to Telegram to ensure the webhook is secure.
WEBHOOK_SECRET=""
# The IP address and port the bot will listen on.
WEBHOOK_LISTEN_ADDRESS="0.0.0.0"
WEBHOOK_PORT="8443"

# Display timezone for dates shown in the bot (IANA name).
DISPLAY_TIMEZONE="UTC"
LOG_LEVEL="INFO"
